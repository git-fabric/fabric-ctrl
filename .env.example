# GitHub App credentials
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/fabric-ctrl.pem
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# Optional: OAuth (only if needed for user-level flows)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Webhook server
WEBHOOK_PORT=3000
WEBHOOK_PATH=/webhooks/github

# MCP server
MCP_SERVER_NAME=fabric-ctrl
MCP_SERVER_VERSION=0.1.0

# Gateway config (path to gateway.yaml)
GATEWAY_CONFIG=./gateway.yaml

# Audit log persistence
AUDIT_LOG_DIR=./state

# Notifications (Slack incoming webhook, Discord /slack endpoint, or any JSON webhook)
NOTIFY_WEBHOOK_URL=
NOTIFY_TIMEOUT_MS=5000

# ── Fabric app credentials ───────────────────────────────────────────────────
# Each fabric app reads its own env vars at createApp() time.
# Set them here so the embedded gateway injects them.

# UniFi
UNIFI_HOST=
UNIFI_API_KEY=

# Proxmox
PROXMOX_HOST=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=

# Kubernetes
KUBECONFIG=

# Tailscale
TAILSCALE_API_KEY=
TAILSCALE_TAILNET=

# Cloudflare
CLOUDFLARE_API_TOKEN=

# Sandfly
SANDFLY_HOST=
SANDFLY_USERNAME=
SANDFLY_PASSWORD=

# CVE
GITHUB_TOKEN=
STATE_REPO=
MANAGED_REPOS=
NVD_API_KEY=

# Git
GIT_STEER_TOKEN=

# Chat
CHAT_STATE_REPO=

# Aiana
AIANA_STATE_REPO=
