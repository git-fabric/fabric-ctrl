# GitHub App credentials
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/fabric-ctrl.pem
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# Optional: OAuth (only if needed for user-level flows)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Webhook server
WEBHOOK_PORT=3000
WEBHOOK_PATH=/webhooks/github

# MCP server
MCP_SERVER_NAME=fabric-ctrl
MCP_SERVER_VERSION=0.1.0

# Gateway config (path to gateway.yaml)
GATEWAY_CONFIG=./gateway.yaml

# MCP over HTTP (omit for stdio only)
# MCP_HTTP_PORT=

# fabric-invoke: Ollama models, fabric-sdk gateway, Aiana memory
# OLLAMA_ENDPOINT=http://ollama.fabric-sdk:11434
# GATEWAY_URL=http://fabric-gateway.fabric-sdk:7340
# AIANA_ENDPOINT=http://fabric-aiana.fabric-sdk:8100
# ROUTER_TIMEOUT_MS=10000
# SPECIALIST_TIMEOUT_MS=30000

# fabric_resolve inventory TTL; records older than this report health "unknown"
RESOLVE_TTL_SECONDS=300

# Audit log persistence
AUDIT_LOG_DIR=./state

# Notifications (Slack incoming webhook, Discord /slack endpoint, or any JSON webhook)
NOTIFY_WEBHOOK_URL=
NOTIFY_TIMEOUT_MS=5000

# ── Fabric app credentials ───────────────────────────────────────────────────
# Each fabric app reads its own env vars at createApp() time.
# Set them here — fabric-ctrl is the credential plane.

# UniFi (https://api.ui.com)
UNIFI_API_KEY=

# Proxmox
PROXMOX_HOST=
PROXMOX_USER=
PROXMOX_TOKEN_NAME=
PROXMOX_TOKEN_VALUE=
# PROXMOX_PASSWORD=            # alternative to token auth
# PROXMOX_PORT=8006
# PROXMOX_VERIFY_SSL=false

# Kubernetes
# K8S_IN_CLUSTER=true          # set for in-cluster; omit + set KUBECONFIG for local
KUBECONFIG=

# Tailscale
TAILSCALE_API_KEY=
# TAILSCALE_TAILNET=-          # defaults to authenticated user's tailnet

# Cloudflare
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Sandfly
SANDFLY_HOST=
SANDFLY_USERNAME=
SANDFLY_PASSWORD=
# SANDFLY_VERIFY_SSL=true

# CVE + Git (shared GitHub token)
GITHUB_TOKEN=
STATE_REPO=
MANAGED_REPOS=
# NVD_API_KEY=                 # optional, raises NVD rate limit
# GITHUB_ORG=                  # default org for git operations

# Chat
ANTHROPIC_API_KEY=
QDRANT_URL=
# QDRANT_API_KEY=              # omit for in-cluster no-auth
# FABRIC_GATEWAY_URL=
# OLLAMA_ENDPOINT=             # shared with fabric-invoke above
# OLLAMA_MODEL=qwen2.5-coder:3b

# Aiana
# QDRANT_URL=                  # shared with Chat above
# QDRANT_API_KEY=              # shared with Chat above
OPENAI_API_KEY=
