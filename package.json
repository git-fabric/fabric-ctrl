{
  "name": "@git-fabric/fabric-ctrl",
  "version": "0.1.0",
  "description": "Zero-trust control plane for the git-fabric org \u2014 GitHub App identity, security automation, and MCP aggregation plane.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev:app": "tsx watch src/app/index.ts",
    "dev:mcp": "tsx watch src/mcp/index.ts",
    "start:app": "node dist/app/index.js",
    "start:mcp": "node dist/mcp/index.js",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@git-fabric/aiana": "github:git-fabric/aiana",
    "@git-fabric/chat": "github:git-fabric/chat",
    "@git-fabric/cloudflare": "github:git-fabric/cloudflare",
    "@git-fabric/cve": "github:git-fabric/cve",
    "@git-fabric/gateway": "github:git-fabric/gateway",
    "@git-fabric/git": "github:git-fabric/git",
    "@git-fabric/k8s": "github:git-fabric/k8s",
    "@git-fabric/proxmox": "github:git-fabric/proxmox",
    "@git-fabric/sandfly": "github:git-fabric/sandfly",
    "@git-fabric/tailscale": "github:git-fabric/tailscale",
    "@git-fabric/unifi": "github:git-fabric/unifi#main",
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@octokit/app": "^15.0.0",
    "@octokit/auth-app": "^7.0.0",
    "@octokit/rest": "^21.0.0",
    "@octokit/webhooks": "^13.0.0",
    "dotenv": "^16.0.0",
    "hono": "^4.13.13",
    "yaml": "^2.9.1",
    "zod": "^3.22.0",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
