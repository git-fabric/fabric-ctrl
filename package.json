{
  "name": "@git-fabric/fabric-ctrl",
  "version": "0.1.0",
  "description": "Zero-trust control plane for the git-fabric org — GitHub App identity, security automation, and MCP org tooling.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev:app": "tsx watch src/app/index.ts",
    "dev:mcp": "tsx watch src/mcp/index.ts",
    "start:app": "node dist/app/index.js",
    "start:mcp": "node dist/mcp/index.js",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@octokit/app": "^15.0.0",
    "@octokit/auth-app": "^7.0.0",
    "@octokit/rest": "^21.0.0",
    "@octokit/webhooks": "^13.0.0",
    "dotenv": "^16.0.0",
    "hono": "^4.0.0",
    "zod": "^3.22.0",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
